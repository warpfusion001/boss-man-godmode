# =============================================================================
# Boss Man Godmode — environment placeholders
# EXAMPLE_ONLY — replace with your own keys from the signup URLs below.
# NEVER commit real keys. Prefer Grok Bot vault / plugin OAuth over .env files.
# =============================================================================

# fal.ai — https://fal.ai  ·  MCP (preferred): https://mcp.fal.ai/mcp-relay
# Free sandbox: signed-in daily Flux/Wan video quotas; API is prepaid credits.
# Prefer OAuth MCP for Grok Bot — do not paste tokens into chat.
FAL_KEY=fal_xxxxxxxx_EXAMPLE_ONLY

# ElevenLabs — https://elevenlabs.io/pricing  ·  MCP: https://elevenlabs.io/mcp
# Free ~10,000 credits/month (no card). Credits do not roll over.
ELEVENLABS_API_KEY=sk_xxxxxxxx_EXAMPLE_ONLY

# OpenRouter — https://openrouter.ai/docs/api_reference/limits
# Free models: append :free — ~20 RPM / 50 req/day (more after $10 lifetime spend).
OPENROUTER_API_KEY=sk-or-xxxxxxxx_EXAMPLE_ONLY

# Groq — https://console.groq.com
# Free tier per-model RPM/RPD; no card required for free tier (see billing FAQ).
GROQ_API_KEY=gsk_xxxxxxxx_EXAMPLE_ONLY

# Pollinations — https://github.com/pollinations/pollinations
# Classic image URL needs NO key: https://image.pollinations.ai/prompt/{encoded}
# Optional keyed endpoint for higher limits / no watermark.
POLLINATIONS_API_KEY=

# Replicate — https://replicate.com/collections/try-for-free  ·  MCP: https://mcp.replicate.com/sse
# Limited free runs after account; not forever-free. Licences per model.
REPLICATE_API_TOKEN=r8_xxxxxxxx_EXAMPLE_ONLY

# Hugging Face Inference Providers — https://huggingface.co/docs/inference-providers
# ~$0.10/mo free credits. Use a fine-grained token with Inference Providers.
HF_TOKEN=hf_xxxxxxxx_EXAMPLE_ONLY

# Cloudflare Workers AI — https://developers.cloudflare.com/workers-ai/platform/pricing/
# 10,000 Neurons/day (resets 00:00 UTC). Hard stop when exhausted.
CLOUDFLARE_API_TOKEN=xxxxxxxx_EXAMPLE_ONLY
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx_EXAMPLE_ONLY

# Optional paid / freemium
# GEMINI_API_KEY=AIzaxxxxxxxx_EXAMPLE_ONLY   # https://aistudio.google.com
# XAI_API_KEY=xai-xxxxxxxx_EXAMPLE_ONLY      # https://x.ai/pricing — no free API tier
# FIREWORKS_API_KEY=xxxxxxxx_EXAMPLE_ONLY    # trial credits only
